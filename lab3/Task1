class Student:
    def __init__(self, name, age, specialty):
        self.name = name
        self.age = age
        self.specialty = specialty
        self.group = "IT-23"

    def show_info(self):
        print("Имя:", self.name)
        print("Возраст:", self.age)
        print("Специальность:", self.specialty)
        print("Группа:", self.group)

    def change_specialty(self, new_specialty):
        self.specialty = new_specialty

    def change_age(self, new_age):
        self.age = new_age

    def change_group(self, new_group):
        self.group = new_group

student1 = Student("Аян", 18, "Программная инженерия")
student2 = Student("Ерлан", 19, "Информационные системы")
student3 = Student("Данияр", 18, "Компьютерные науки")

student1.show_info()
print()

student2.show_info()
print()

student3.show_info()

print("\nПосле изменения:")

student1.change_specialty("Информационные технологии")
student1.show_info()

student2.change_age(20)
print()
student2.show_info()

student3.change_group("IT-24")
print()
student3.show_info()
